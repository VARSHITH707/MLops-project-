# Copy to .env and change the values. Never commit .env.
# Shared secret for /admin/* endpoints (retrain, rollback, simulate). Unset = admin disabled.
PM_ADMIN_API_KEY=change-me-to-a-long-random-string
# Turn on the condition-based retraining scheduler (checks every scheduler_interval_seconds).
PM_SCHEDULER_ENABLED=false
# Where the dashboard finds the API.
API_URL=http://localhost:8000
# Optional: point MLflow at another tracking store/server.
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# Set to 1 to skip MLflow logging entirely (training still works).
PM_DISABLE_MLFLOW=0
